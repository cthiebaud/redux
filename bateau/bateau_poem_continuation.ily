    \line { "Et je voguais, lorsqu’à travers mes liens frêles" }
    \line { "Des noyés descendaient dormir, à reculons !" }
}

\markup \column {
  \sectionLineMarkup "Sequence"
  \vspace #1
    \line { "⑱ Or moi, bateau perdu sous les cheveux des anses," }
